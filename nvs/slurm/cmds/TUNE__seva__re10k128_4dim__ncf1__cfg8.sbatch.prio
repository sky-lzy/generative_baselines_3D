#!/bin/bash
#SBATCH --job-name=fnvs_TUNE__seva__re10k128_4dim__ncf1__cfg8
#SBATCH --partition=kempner_h200_priority
#SBATCH --account=kempner_ydu_lab
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --gres=gpu:1
#SBATCH --constraint="h200"
#SBATCH --mem=64G
#SBATCH --time=01:30:00
#SBATCH --nice=0
#SBATCH --requeue
#SBATCH --open-mode=append
#SBATCH --output=/n/lab_storage/ydu_lab/Lab/akiruga/world_model_4d/standardized_eval_new/nvs/slurm/logs/TUNE__seva__re10k128_4dim__ncf1__cfg8.%j.out
set -uo pipefail
echo "=== $(date '+%F %T') host=$(hostname) job=$SLURM_JOB_ID part=$SLURM_JOB_PARTITION"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
# one-core job (see submit_fair.py CPU POLICY): do not let BLAS spawn a thread per core
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
export HF_HOME=/n/netscratch/ydu_lab/Lab/akiruga
export VWM_REPO=/n/lab_storage/ydu_lab/Lab/akiruga/world_model_4d/video_world_model_new
export SEVA_REPO=/n/lab_storage/ydu_lab/Lab/akiruga/stable-virtual-camera
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export INFER_DIT_BF16=0
cd /n/lab_storage/ydu_lab/Lab/akiruga/world_model_4d/video_world_model_new
/n/lab_storage/ydu_lab/akiruga/.conda/envs/test2/bin/python /n/lab_storage/ydu_lab/Lab/akiruga/world_model_4d/standardized_eval_new/nvs/inference/run_seva_infer.py --data_root /n/netscratch/ydu_lab/Lab/akiruga/vwm_eval_data/svc_bench/scenes_fair/re10k128_4dim --output_dir /n/lab_storage/ydu_lab/Lab/akiruga/world_model_4d/standardized_eval_new/nvs/preds_fair/TUNE__seva__re10k128_4dim__ncf1__cfg8 --num_cond_frames 1 --camera_scale 1.0 --H 576 --W 768 --cfg 8 --seva_repo /n/lab_storage/ydu_lab/Lab/akiruga/stable-virtual-camera --save_subdir fair_TUNE__seva__re10k128_4dim__ncf1__cfg8 --scenes 00a861d699fb7797,00b9a7963f9bd9c6,017c0058a6c6e645,056cd557d2bdd490,08362ea89cc94616,089df100b0a334ed,0c7cadc659ac1393,0d2e6f976f5f5522,0de22e4f66f408e2,0fcee80286318859
rc=$?
echo "=== $(date '+%F %T') EXIT $rc"
exit $rc
